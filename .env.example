# Local preview only. Explicitly change these for deployment.
APP_DEMO=true
PAYMENT_MODE=mock
APP_ORIGIN=http://localhost:4173
PORT=4173
DATABASE_URL=file:.data/arunia.db
# Production requires a remote libSQL/Turso database and its token.
DATABASE_AUTH_TOKEN=
# Toss widget keys must be a matching test or live pair. Never prefix secrets with VITE_.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
# Enable public live operation only after actual roster and policies are entered.
OPERATIONS_READY=false
