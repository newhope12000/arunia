{
  "buildCommand": "npm run build:review",
  "outputDirectory": "review-dist",
  "env": {
    "ARUNIA_REVIEW_ONLY": "true"
  },
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/archive/:path*",
      "destination": "/:path*",
      "permanent": false
    },
    {
      "source": "/hunmin/index.html",
      "destination": "/hunmin",
      "permanent": true
    },
    {
      "source": "/hunmin/",
      "destination": "/hunmin",
      "permanent": true
    },
    {
      "source": "/hunmin/apply.html",
      "destination": "/hunmin/apply",
      "permanent": true
    },
    {
      "source": "/hunmin/apply/",
      "destination": "/hunmin/apply",
      "permanent": true
    },
    {
      "source": "/hunmin/thanks.html",
      "destination": "/hunmin/thanks",
      "permanent": true
    },
    {
      "source": "/hunmin/thanks/",
      "destination": "/hunmin/thanks",
      "permanent": true
    },
    {
      "source": "/career-core-up/index.html",
      "destination": "/career-core-up",
      "permanent": true
    },
    {
      "source": "/career-core-up/",
      "destination": "/career-core-up",
      "permanent": true
    },
    {
      "source": "/career-core-up/thanks.html",
      "destination": "/career-core-up/thanks",
      "permanent": true
    },
    {
      "source": "/career-core-up/thanks/",
      "destination": "/career-core-up/thanks",
      "permanent": true
    },
    {
      "source": "/news/index.html",
      "destination": "/news",
      "permanent": true
    },
    {
      "source": "/news/",
      "destination": "/news",
      "permanent": true
    },
    {
      "source": "/news/:slug.html",
      "destination": "/news/:slug",
      "permanent": true
    },
    {
      "source": "/news/:slug/",
      "destination": "/news/:slug",
      "permanent": true
    },
    {
      "source": "/contact/",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/notices/index.html",
      "destination": "/notices",
      "permanent": true
    },
    {
      "source": "/notices/",
      "destination": "/notices",
      "permanent": true
    },
    {
      "source": "/notices/:slug.html",
      "destination": "/notices/:slug",
      "permanent": true
    },
    {
      "source": "/notices/:slug/",
      "destination": "/notices/:slug",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/hunmin",
      "destination": "/hunmin/index.html"
    },
    {
      "source": "/hunmin/apply",
      "destination": "/hunmin/apply.html"
    },
    {
      "source": "/hunmin/thanks",
      "destination": "/hunmin/thanks.html"
    },
    {
      "source": "/career-core-up",
      "destination": "/career-core-up/index.html"
    },
    {
      "source": "/career-core-up/thanks",
      "destination": "/career-core-up/thanks.html"
    },
    {
      "source": "/preview/:path*",
      "destination": "/preview/index.html"
    },
    {
      "source": "/news",
      "destination": "/news/index.html"
    },
    {
      "source": "/news/:slug",
      "destination": "/news/:slug.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/notices",
      "destination": "/notices/index.html"
    },
    {
      "source": "/notices/:slug",
      "destination": "/notices/:slug.html"
    }
  ],
  "headers": [
    {
      "source": "/v0_1",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/v0_1/",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/v0_1/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/preview/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
