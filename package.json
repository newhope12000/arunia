{
  "name": "arunia",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/start.js",
    "build": "tsc -b && vite build",
    "build:review": "tsc -b && node scripts/build-review.mjs",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/start.js",
    "test": "node --test tests/*.test.js",
    "admin": "node --env-file-if-exists=.env server/admin.js",
    "format": "prettier --write src server api tests"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "express": "^5.1.0",
    "google-auth-library": "^11.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.7",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
